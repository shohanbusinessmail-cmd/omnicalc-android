<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy cloud-backup rules (API < 31). Same policy as data_extraction_rules.xml:
  history/favorites stay off cloud backups by default (docs/PRIVACY.md).
-->
<full-backup-content>
    <exclude domain="database" path="omnicalc.db" />
    <exclude domain="database" path="omnicalc.db-shm" />
    <exclude domain="database" path="omnicalc.db-wal" />
    <exclude domain="file" path="exports/" />
</full-backup-content>
