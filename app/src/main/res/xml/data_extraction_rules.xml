<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup rules (API 31+, used by android:dataExtractionRules).
  Calculation history/favorites are excluded from cloud backup by default:
  they are personal data the user can export explicitly (see docs/PRIVACY.md).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="omnicalc.db" />
        <exclude domain="database" path="omnicalc.db-shm" />
        <exclude domain="database" path="omnicalc.db-wal" />
        <exclude domain="file" path="exports/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="omnicalc.db" />
        <exclude domain="database" path="omnicalc.db-shm" />
        <exclude domain="database" path="omnicalc.db-wal" />
    </device-transfer>
</data-extraction-rules>
