<?xml version="1.0" encoding="utf-8"?>
<!--
  OmniCalc launcher foreground — "Infinity Mark":
  two tangent stroked loops forming an infinity symbol, with a subtle 2x2
  calculator keypad inside the left loop and an equals sign inside the right.
  Single-color (white) on transparent so it adapts to the background layer
  and doubles as the splash icon. All geometry sits inside the 66dp adaptive
  safe zone (21..87 of 108) except the outer loop edges (22/86) which stay
  within the recommended padding ring.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left loop of the infinity mark (stroked) -->
    <path
        android:pathData="M54,54 C54,44.9 46.8,36 38,36 C29.2,36 22,44.9 22,54 C22,63.1 29.2,72 38,72 C46.8,72 54,63.1 54,54 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Right loop of the infinity mark (stroked) -->
    <path
        android:pathData="M54,54 C54,44.9 61.2,36 70,36 C78.8,36 86,44.9 86,54 C86,63.1 78.8,72 70,72 C61.2,72 54,63.1 54,54 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- 2x2 keypad dots inside the left loop -->
    <path
        android:pathData="M30.4,47 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0 Z"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M40.4,47 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0 Z"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M30.4,61 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0 Z"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M40.4,61 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0 Z"
        android:fillColor="#FFFFFF" />

    <!-- Equals sign inside the right loop -->
    <path
        android:pathData="M63.5,50.5 H76.5 V53.5 H63.5 Z"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M63.5,55 H76.5 V58 H63.5 Z"
        android:fillColor="#FFFFFF" />
</vector>
